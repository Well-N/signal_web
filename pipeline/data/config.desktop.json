{
  "ai": {
    "provider": "openai",
    "model": "${LLM_MODEL}",
    "base_url": "${LLM_BASE_URL}",
    "api_key_env": "LLM_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 4,
    "enrichment_concurrency": 3,
    "languages": [
      "zh"
    ]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "ai-news",
    "profile_settings": {
      "ai-news": {
        "threshold": 6,
        "topic_dedup": true
      },
      "finance-news": {
        "threshold": 6,
        "topic_dedup": true
      },
      "world-news": {
        "threshold": 6,
        "topic_dedup": true
      },
      "solopreneur": {
        "threshold": 6,
        "topic_dedup": true
      },
      "cross-border": {
        "threshold": 6,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 50,
      "profile": "ai-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-news",
        "profile": "ai-news",
        "content_extractor": "trafilatura",
        "max_items": 10
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
